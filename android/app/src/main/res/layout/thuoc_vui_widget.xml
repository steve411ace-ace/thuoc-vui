<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="13dp"
    android:paddingVertical="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/widget_pill"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_pill" />
        <TextView
            android:id="@+id/widget_title"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="Thuốc Vui"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#333333" />
        <TextClock
            android:id="@+id/widget_datetime"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textSize="11sp"
            android:textColor="#333333"
            android:format24Hour="dd/MM/yyyy • HH:mm:ss"
            android:format12Hour="dd/MM/yyyy • hh:mm:ss" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/widget_pip_face"
            android:layout_width="17dp"
            android:layout_height="21dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_pip_happy" />
        <TextView
            android:id="@+id/widget_pip"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="#333333" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_progress"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#333333" />
    <ImageView
        android:id="@+id/widget_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:layout_marginBottom="4dp" />
    <LinearLayout
        android:id="@+id/widget_next_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:background="@drawable/next_card_light"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">
        <TextView
            android:id="@+id/widget_next"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#333333" />
        <TextView
            android:id="@+id/widget_next_time"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="#666666" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/widget_checkin_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <ImageView
            android:id="@+id/widget_checkin_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_action_pill" />
        <Button
            android:id="@+id/widget_checkin"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="Đã uống lần này"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </FrameLayout>
    <TextView
        android:id="@+id/widget_done"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="🎉 Đã xong hôm nay!"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_done_detail"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#333333"
        android:visibility="gone" />
</LinearLayout>
