<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="Thuốc Vui 💊"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#333333" />
        <TextClock
            android:id="@+id/widget_datetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textSize="15sp"
            android:textColor="#333333"
            android:format24Hour="dd/MM/yyyy • HH:mm:ss"
            android:format12Hour="dd/MM/yyyy • hh:mm:ss" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_pip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textColor="#333333" />
    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="15sp"
        android:textColor="#333333" />
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#2BB3A3"
        android:progressBackgroundTint="#D9E8E5" />
    <LinearLayout
        android:id="@+id/widget_next_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:background="@drawable/next_card_light"
        android:padding="6dp">
        <TextView
            android:id="@+id/widget_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333" />
        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:textColor="#666666" />
    </LinearLayout>
    <Button
        android:id="@+id/widget_checkin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="42dp"
        android:text="Đã uống lần này"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2BB3A3" />
    <TextView
        android:id="@+id/widget_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="🎉 Đã xong hôm nay!"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_done_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="14sp"
        android:textColor="#333333"
        android:visibility="gone" />
</LinearLayout>
