<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="14dp"
    android:paddingVertical="13dp">

    <!-- Header: Brand badge + Title + TextClock pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:paddingHorizontal="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_pill"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_hero_mask" />

        <TextView
            android:id="@+id/widget_title"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Thuốc Vui"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextClock
            android:id="@+id/widget_datetime"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_clock_bg_light"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:singleLine="true"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:format24Hour="dd/MM/yyyy • HH:mm:ss"
            android:format12Hour="dd/MM/yyyy • hh:mm:ss" />
    </LinearLayout>

    <!-- Hero Bento Gradient Card: 76dp Progress Ring (%) + Today Progress + Status Message -->
    <FrameLayout
        android:id="@+id/widget_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/widget_hero_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_hero_mask" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- 76dp Progress Ring (only % in center, no Pip face) -->
            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp">

                <ImageView
                    android:id="@+id/widget_progress_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_ring_pct"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0%"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hero_kicker"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:maxLines="1"
                    android:text="Tiến độ hôm nay"
                    android:textSize="10.5sp"
                    android:textColor="#CCFFFFFF" />

                <TextView
                    android:id="@+id/widget_progress"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"
                    android:text="Thuốc Vui"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:id="@+id/widget_status_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_status_dot" />

                    <TextView
                        android:id="@+id/widget_pip"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp"
                        android:textSize="11sp"
                        android:textColor="#F0FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- State 1: Pending Next Dose Bento Card -->
    <LinearLayout
        android:id="@+id/widget_next_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/next_card_light"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- 42dp Pill Shape Icon Box -->
        <FrameLayout
            android:id="@+id/widget_shape_box"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="11dp">

            <ImageView
                android:id="@+id/widget_shape_box_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_box_bg" />

            <ImageView
                android:id="@+id/widget_shape_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_capsule" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_next_tag"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:maxLines="1"
                android:text="LẦN UỐNG TIẾP THEO"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/widget_next"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Mở app để xem lịch hôm nay"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/widget_next_time"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>
    </LinearLayout>

    <!-- State 1: Check-in Bento CTA Button (16dp corners) -->
    <FrameLayout
        android:id="@+id/widget_checkin_row"
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/widget_checkin_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_action_pill" />

        <ImageView
            android:id="@+id/widget_checkin_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_action_bento_border"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_checkin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/widget_checkin_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_check" />

            <TextView
                android:id="@+id/widget_checkin_label"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:maxLines="1"
                android:text="Đã uống lần này"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- State 2: All-Done Bento Card (emerald #10B981 border) -->
    <LinearLayout
        android:id="@+id/widget_done_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/done_card_light"
        android:paddingHorizontal="13dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_done_circle" />

            <TextView
                android:id="@+id/widget_done"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="🎉 Đã xong hôm nay!"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />
        </LinearLayout>

        <!-- Done dose item 1 -->
        <LinearLayout
            android:id="@+id/widget_done_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/done_item_light"
            android:paddingHorizontal="9dp"
            android:paddingVertical="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_done_1_line1"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/widget_done_1_line2"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="10.5sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Done dose item 2 -->
        <LinearLayout
            android:id="@+id/widget_done_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="vertical"
            android:background="@drawable/done_item_light"
            android:paddingHorizontal="9dp"
            android:paddingVertical="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_done_2_line1"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/widget_done_2_line2"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="10.5sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Done dose item 3 -->
        <LinearLayout
            android:id="@+id/widget_done_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="vertical"
            android:background="@drawable/done_item_light"
            android:paddingHorizontal="9dp"
            android:paddingVertical="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_done_3_line1"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/widget_done_3_line2"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="10.5sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_done_more"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="10.5sp"
            android:textColor="#64748B"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
