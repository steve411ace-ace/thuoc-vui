<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="0dp"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <!-- Hero Bento Gradient Card (giãn theo chiều cao khung nhờ layout_weight="1") -->
    <FrameLayout
        android:id="@+id/widget_hero_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/widget_hero_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_hero_mask" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp">

            <!-- Row 1 inside Hero: Brand icon + App name (19sp) + TextClock pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/widget_hero_logo_bg">

                    <ImageView
                        android:id="@+id/widget_pill"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_capsule" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_title"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Thuốc Vui"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextClock
                    android:id="@+id/widget_datetime"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_hero_clock_bg"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#F5FFFFFF"
                    android:format24Hour="dd/MM/yyyy • HH:mm:ss"
                    android:format12Hour="dd/MM/yyyy • hh:mm:ss" />
            </LinearLayout>

            <!-- Row 2 inside Hero: 56dp Progress Ring (%) + Today Progress + Status Message (2+ lines) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <ImageView
                        android:id="@+id/widget_progress_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/widget_ring_pct"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="0%"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_hero_kicker"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="Tiến độ hôm nay"
                        android:textSize="10sp"
                        android:textColor="#CCFFFFFF" />

                    <TextView
                        android:id="@+id/widget_progress"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Thuốc Vui"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <ImageView
                            android:id="@+id/widget_status_dot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_status_dot" />

                        <TextView
                            android:id="@+id/widget_pip"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp"
                            android:textSize="12sp"
                            android:textColor="#F0FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- State 1: Pending Next Dose Bento Card -->
    <LinearLayout
        android:id="@+id/widget_next_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/next_card_light"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <!-- 44dp Pill Shape Icon Box (exact widget_ic_capsule.xml) -->
        <FrameLayout
            android:id="@+id/widget_shape_box"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/widget_shape_box_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_box_bg" />

            <ImageView
                android:id="@+id/widget_shape_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_capsule" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_next_tag"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="LẦN UỐNG TIẾP THEO"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/widget_next"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Mở app để xem lịch hôm nay"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/widget_next_time"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11.5sp"
                android:textColor="#64748B" />
        </LinearLayout>
    </LinearLayout>

    <!-- State 1: Check-in Bento CTA Button (52dp height, 16dp corners) -->
    <FrameLayout
        android:id="@+id/widget_checkin_row"
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/widget_checkin_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_action_pill" />

        <ImageView
            android:id="@+id/widget_checkin_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_action_bento_border"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_checkin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/widget_checkin_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_check" />

            <TextView
                android:id="@+id/widget_checkin_label"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="Đã uống lần này"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- State 2: All-Done Bento Card (emerald #10B981 border) -->
    <LinearLayout
        android:id="@+id/widget_done_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/done_card_light"
        android:paddingHorizontal="11dp"
        android:paddingVertical="9dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_done_circle" />

            <TextView
                android:id="@+id/widget_done"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="🎉 Đã xong hôm nay!"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />
        </LinearLayout>

        <!-- Done dose item 1 -->
        <LinearLayout
            android:id="@+id/widget_done_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/done_item_light"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_done_1_line1"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/widget_done_1_line2"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Done dose item 2 -->
        <LinearLayout
            android:id="@+id/widget_done_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@drawable/done_item_light"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_done_2_line1"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/widget_done_2_line2"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Done dose item 3 (shown when resized to 4x3+) -->
        <LinearLayout
            android:id="@+id/widget_done_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@drawable/done_item_light"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_done_3_line1"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/widget_done_3_line2"
                android:fontFamily="@font/be_vietnam_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_done_more"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="10.5sp"
            android:textColor="#64748B"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
